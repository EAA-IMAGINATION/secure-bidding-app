h1 class="text-center mb-4" Reset password

div class="row justify-content-center"
  div class="col-md-7 col-lg-6"
    div class="card shadow-sm"
      div class="card-body p-4 p-md-5"
        p class="text-muted mb-4"
          | Enter the email for the account you want to recover and choose a new password.

        form method="post" action="/auth/reset-password" id="form-reset-password"
          div class="mb-3"
            label.form-label for="input-reset-email" Email
            input#input-reset-email.form-control type="email" name="email" placeholder="name@example.com" required="required" autofocus="autofocus"

          div class="mb-4"
            label.form-label for="input-reset-password" New password
            input#input-reset-password.form-control type="password" name="password" placeholder="Create a new password" required="required"

          button.btn.btn-primary.btn-lg.w-100 type="submit" Update password

        div class="text-center mt-3"
          a href="/auth/login" class="link-secondary text-decoration-none" Back to login
