div class="row justify-content-center mt-4"
  div class="col-lg-6"
    a href="/" class="btn btn-outline-secondary mb-3" Back to Projects

    div class="card"
      div class="card-body"
        h2 class="card-title mb-4" Create New Project

        form method="post" action="/projects" id="project-form"
          div class="mb-3"
            label for="title" class="form-label" Project Title
            input type="text" class="form-control" id="title" name="title" required=true placeholder="Enter project title"

          div class="mb-3"
            label for="budget_cents" class="form-label" Budget (in cents)
            input type="number" class="form-control" id="budget_cents" name="budget_cents" required=true min="0" placeholder="e.g., 120000 for $1200.00"
            small class="form-text text-muted" Note: Enter amount in cents (1 dollar = 100 cents)

          div class="mb-3"
            label for="bidding_deadline" class="form-label" Bidding Deadline
            input type="datetime-local" class="form-control" id="bidding_deadline" name="bidding_deadline" required=true
            small class="form-text text-muted" Bids will be locked after this time (in your local timezone)

          div class="mb-3"
            label for="state" class="form-label" Project State
            select class="form-select" id="state" name="state"
              option value="saved" Save as Draft
              option value="published" Publish Immediately

          div class="mb-3"
            label for="project_passphrase" class="form-label" Project Passphrase
            input type="password" class="form-control" id="project_passphrase" name="project_passphrase" required=true minlength="8" placeholder="Strong passphrase to secure project encryption keys"
            small class="form-text text-muted" Use a strong passphrase (8+ characters). This is needed to decrypt private keys.

          / Hidden fields for NaCl encryption keys (populated by JS)
          input type="hidden" id="nacl_public_key" name="nacl_public_key" value=""
          input type="hidden" id="nacl_encrypted_private_key" name="nacl_encrypted_private_key" value=""

          div class="mb-3" id="crypto-status" style="display: none;"
            div class="alert alert-info" role="alert"
              span id="crypto-message" Generating cryptographic keys...

          button type="submit" class="btn btn-primary w-100" id="submit-btn" disabled=true Create Project

