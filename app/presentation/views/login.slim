h1 class="text-center mb-4" Login

div class="row justify-content-center"
  div class="col-md-7 col-lg-6"
    div class="card shadow-sm"
      div class="card-body p-4 p-md-5"
        p class="text-muted mb-4"
          | Sign in to manage your profile and account details.

        form method="post" action="/auth/login" id="form-login" accept-charset="UTF-8"
          div class="mb-3"
            label.form-label for="input-username" Username
            input#input-username.form-control type="text" name="username" placeholder="Enter your username" required="required" autofocus="autofocus"

          div class="mb-4"
            label.form-label for="input-password" Password
            input#input-password.form-control type="password" name="password" placeholder="Enter your password" required="required"

          button.btn.btn-primary.btn-lg.w-100 type="submit" Login
