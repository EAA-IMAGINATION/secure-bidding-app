- account ||= @current_account
- profile_roles = account&.dig('profile_roles')
- if profile_roles.nil? || profile_roles.empty?
  - assigned_roles = (account&.dig('include', 'system_roles') || account&.dig('system_roles') || []).dup
  - column_role = account&.dig('system_role')
  - assigned_roles << column_role if column_role && !assigned_roles.include?(column_role)
  - profile_roles = assigned_roles.sort.uniq
- verified = account_email_verified?(account)

div class="row justify-content-center mt-4"
  div class="col-md-9 col-lg-8"
    div class="card shadow-sm"
      div class="card-body p-4 p-md-5"
        p class="text-uppercase text-primary fw-semibold mb-2" Account
        h1 class="h3 mb-4" Account details

        dl class="row mb-0"
          dt class="col-sm-3 text-muted" Username
          dd class="col-sm-9 mb-3"
            = account['username']

          dt class="col-sm-3 text-muted" Email
          dd class="col-sm-9 mb-3"
            = account['email']

          dt class="col-sm-3 text-muted" Verification
          dd class="col-sm-9 mb-3"
            - if verified
              span class="badge bg-success" Verified
            - else
              div class="d-flex align-items-center flex-wrap gap-2"
                span class="badge bg-warning text-dark" Unverified
                form method="post" action="/account/#{account['username']}/resend_verification" class="mb-0"
                  button type="submit" class="btn btn-sm btn-outline-primary" Send verification email
              p class="text-muted small mb-0 mt-2" Open the link in your email to verify this address.

          dt class="col-sm-3 text-muted" Roles
          dd class="col-sm-9 mb-0"
            - if profile_roles.empty?
              span class="text-muted" No roles assigned
            - else
              - profile_roles.each do |role|
                span class="badge bg-secondary me-1"
                  = role

        div class="d-flex flex-wrap gap-2 mt-4"
          a href="/" class="btn btn-outline-secondary" Back to home
          a href="/account/#{account['username']}/edit" class="btn btn-primary" Edit profile
          a href="/auth/logout" class="btn btn-danger" Logout

        - if api_key
          div class="row top-buffer mt-4"
            div class="col-sm-12"
              h3 API Access
              p class="text-muted mb-2"
                | Read-only API key (valid for one month). Use this from the command line for read-only access.
              a class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" href="#api_key" role="button" aria-expanded="false" aria-controls="api_key"
                | Show key
              div id="api_key" class="collapse mt-2"
                div class="card card-body"
                  pre class="text-wrap mb-0"
                    = api_key
