div class="row justify-content-center mt-4"
  div class="col-lg-6"
    a href="/" class="btn btn-outline-secondary mb-3" Back to Projects

    - if project
      div class="card"
        div class="card-body"
          h2 class="card-title mb-4" Edit Project

          form method="post" action="/projects/#{project['id']}/edit"
            div class="mb-3"
              label for="title" class="form-label" Project Title
              input type="text" class="form-control" id="title" name="title" required="true" placeholder="Enter project title" value="#{project['title']}"

            div class="mb-3"
              label for="budget_cents" class="form-label" Budget (in cents)
              input type="number" class="form-control" id="budget_cents" name="budget_cents" required="true" min="0" placeholder="e.g., 120000 for $1200.00" value="#{project['budget_cents']}"
              small class="form-text text-muted" Note: Enter amount in cents (1 dollar = 100 cents)

            div class="mb-3"
              label for="state" class="form-label" Project State
              select class="form-select" id="state" name="state"
                - if project['state'] == 'saved'
                  option value="saved" selected="true" Save as Draft
                  option value="published" Publish
                - else
                  option value="saved" Save as Draft
                  option value="published" selected="true" Published

            div class="d-flex gap-2"
              button type="submit" class="btn btn-primary" Update Project
              form method="post" action="/projects/#{project['id']}/delete" class="d-inline"
                button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this project?');" Delete Project
    - else
      div class="alert alert-danger" Project not found
