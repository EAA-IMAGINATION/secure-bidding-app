div class="row justify-content-center mt-4"
  div class="col-lg-9"
    div class="p-4 p-md-5 mb-4 rounded-3 bg-white shadow-sm border"
      - if current_account
        p class="text-uppercase text-primary fw-semibold mb-2" Signed in
        h1 class="display-6 mb-3" Welcome back, #{current_account['username']}!
        p class="lead mb-4" You are logged into the Secure Bidding App.
        a href="/account/#{current_account['username']}" class="btn btn-primary btn-lg" View your account
      - else
        p class="text-uppercase text-primary fw-semibold mb-2" Secure bidding
        h1 class="display-6 mb-3" Welcome to Secure Bidding
        p class="lead mb-4" A secure platform for transparent bidding on projects.
        div class="d-flex flex-wrap gap-2"
          a href="/register" class="btn btn-primary btn-lg" Register
          a href="/auth/login" class="btn btn-outline-primary btn-lg" Login
