.container.mt-5
  .row
    .col-12
      h1.mb-4 Projects

      - if projects && projects.length > 0
        .table-responsive
          table.table.table-hover
            thead
              tr
                th Project Title
                th Budget
                th State
                th Actions
            tbody
              - projects.each do |project|
                tr
                  td
                    a href="/projects/#{project['id']}"
                      = project['title']
                  td
                    = project['budget_cents'] ? "$#{(project['budget_cents'] / 100.0).round(2)}" : "N/A"
                  td
                    .badge class=("bg-primary" if project['state'] == 'saved') class=("bg-success" if project['state'] == 'published')
                      = project['state'] || 'Unknown'
                  td
                    .btn-group role="group"
                      a.btn.btn-sm.btn-info href="/projects/#{project['id']}" View
                      - if project && allowed?(project, 'edit')
                        a.btn.btn-sm.btn-warning href="/projects/#{project['id']}/edit" Edit
                      - if project['state'] == 'published' && current_account && allowed?(project, 'submit_bid')
                        a.btn.btn-sm.btn-primary href="/projects/#{project['id']}" Bid
      - else
        .alert.alert-info
          p No projects are available yet.
          a.btn.btn-primary href="/projects/new" Create New Project
