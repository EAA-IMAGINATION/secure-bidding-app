doctype html
html
  head
    title Freelance Procurement Hub
    meta name="google-site-verification" content="VlOFlpPJZVp_tcWnoGAq9UvkBTi7Y9ueuqSjlTF7n4k" /

    / Themed Bootstrap 5.3 (Cerulean theme via Bootswatch)
    link rel="shortcut icon" href="/logo.png"
    link rel="stylesheet" href="https://bootswatch.com/5/cerulean/bootstrap.min.css" integrity="sha384-HqhCRk5UwZdbqmzeyYZHCwu3IuFe84q3c8UZtboEpYrdnIwi0RLZDag0RpKbFBHL" crossorigin="anonymous"

    / Custom CSS
    == assets(:css)

    / Custom app script
    script src="/app.js"
  body
    / Popper + Bootstrap 5.3.3 (jsDelivr CDN)
    script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"
    script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"

    / TweetNaCl.js for client-side encryption
    script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"

    == render :nav
    div class='container' id='html_body'
      section
        == render :flash_bar
        - if @current_account && !account_email_verified?(@current_account)
          div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" role="alert"
            div
              strong Verify your email to unlock bidding and project management.
              span class="d-block small text-muted" You can browse published projects until you verify via the email link.
            form method="post" action="/account/#{@current_account['username']}/resend_verification" class="mb-0"
              button type="submit" class="btn btn-sm btn-primary" Send verification email
        == yield
