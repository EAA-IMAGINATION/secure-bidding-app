h1 class="text-center mb-4" Create an account

div class="row justify-content-center"
  div class="col-md-7 col-lg-6"
    div class="card shadow-sm"
      div class="card-body p-4 p-md-5"
        p class="text-muted mb-4"
          | We'll email you a verification link. Open it to set your password and finish creating your account.

        form method="post" action="/register" id="form-register"
          div class="mb-3"
            label.form-label for="input-username" Username
            input#input-username.form-control type="text" name="username" placeholder="Choose a username" required="required" autofocus="autofocus"

          div class="mb-3"
            label.form-label for="input-email" Email
            input#input-email.form-control type="email" name="email" placeholder="name@example.com" required="required"

          button.btn.btn-primary.btn-lg.w-100 type="submit" Send verification email

        div class="text-center mt-3"
          a href="/auth/login" class="link-secondary text-decoration-none" Back to login
