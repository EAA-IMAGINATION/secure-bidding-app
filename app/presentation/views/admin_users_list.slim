div class="row justify-content-center mt-4"
  div class="col-lg-11"
    a href="/" class="btn btn-outline-secondary mb-3" Back to Home

    div class="d-flex justify-content-between align-items-center mb-4"
      h2 Manage Users
      a href="/admin/users/new" class="btn btn-primary" Create New User

    - if users && users.size > 0
      div class="table-responsive"
        table class="table table-striped table-hover"
          thead class="table-dark"
            tr
              th ID
              th Username
              th Email
              th Roles
              th Actions
          tbody
            - users.each do |user|
              tr
                td
                  = user['id']
                td
                  = user['username']
                td
                  = user['email']
                td
                  - if user['system_roles'] && user['system_roles'].size > 0
                    - user['system_roles'].each do |role|
                      span class="badge bg-info me-1"
                        = role
                  - else
                    span class="badge bg-secondary" user
                td
                  div class="d-flex gap-1"
                    a href="/admin/users/#{user['id']}" class="btn btn-sm btn-info" View
                    a href="/admin/users/#{user['id']}/edit" class="btn btn-sm btn-warning" Edit
                    a href="/admin/users/#{user['id']}/roles" class="btn btn-sm btn-primary" Roles
                    form method="post" action="/admin/users/#{user['id']}/delete" class="d-inline" data-confirm-username="#{user['username']}"
                      button type="submit" class="btn btn-sm btn-danger" Delete
    - else
      div class="alert alert-warning" No users found
