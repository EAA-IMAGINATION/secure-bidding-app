div class="row justify-content-center mt-4"
  div class="col-lg-11"
    a href="/" class="btn btn-outline-secondary mb-3" Back to Home

    h2.mb-4 Users

    - if users && users.size > 0
      div class="table-responsive"
        table class="table table-striped table-hover"
          thead class="table-dark"
            tr
              th Username
              th Email
              th Roles
              th Actions
          tbody
            - users.each do |user|
              tr
                td
                  = user['username']
                td
                  - if user['email'] && !user['email'].to_s.strip.empty?
                    = user['email']
                    - if user['email_verified'] || user['email_verified'] == 'true'
                      span.badge.bg-success.ms-2 Verified
                    - else
                      span.badge.bg-secondary.ms-2 Unverified
                  - else
                    | —
                td
                  - roles = user_role_names(user)
                  - if roles.any?
                    - roles.each do |role|
                      span class="badge bg-info me-1"
                        = role
                  - else
                    span class="text-muted" No roles assigned
                td
                  div class="d-flex gap-1"
                    a href="/admin/users/#{user['id']}" class="btn btn-sm btn-info" View
                    - if can_manage_user_role?(user, current_account)
                      a href="/admin/users/#{user['id']}/roles" class="btn btn-sm btn-primary"
                        = role_action_label(user)
                    - else
                      span class="badge bg-secondary align-self-center" Current admin
    - else
      div class="alert alert-warning" No users found
